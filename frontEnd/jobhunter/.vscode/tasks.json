{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "JobHunter: frontend",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "start"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder}/../../scripts/frontend.ps1",
          "start"
        ]
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building",
          "endsPattern": "Local:"
        }
      }
    },
    {
      "label": "JobHunter: frontend tests",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "test"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-File",
          "${workspaceFolder}/../../scripts/frontend.ps1",
          "test"
        ]
      }
    }
  ]
}
