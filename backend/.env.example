# Generate secrets: python -m app.setup secrets
# Use a dedicated PostgreSQL database. Keep credentials out of Git and chat.
DATABASE_URL=postgresql+asyncpg://jobhunter:CHANGE_ME@localhost:5432/jobhunter
JWT_SECRET=CHANGE_ME
CV_ENCRYPTION_KEY=CHANGE_ME
# Optional private CV paths; defaults are project/local-data/cvs and project/.cache/cv-sandbox.
# Keep originals out of frontend/assets and preserve CV_ENCRYPTION_KEY when upgrading.
# CV_STORAGE_PATH=C:/private/jobhunter/cvs
# CV_SANDBOX_PATH=C:/path/to/JobHunter/.cache/cv-sandbox
ALLOWED_ORIGINS=["https://localhost:4200","https://localhost:8443"]
ENVIRONMENT=development
